# Your Docker Hub account (lowercase, the namespace your workflows push into)
DH_USER=naveenreddy9

# Tags = the github.run_number of the run that built each image.
# Each workflow has its own independent counter, so these WILL differ.
# There is no :latest -- no workflow pushes one.
# Verify:  https://hub.docker.com/r/naveenreddy9/<repo>/tags
CATALOGUE_TAG=11
CART_TAG=15
SHIPPING_TAG=6
RATING_TAG=1
PAYMENT_TAG=1
DISPATCH_TAG=7
WEB_TAG=1
USER_TAG=3

